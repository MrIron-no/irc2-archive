The following diff is a courtesy of Michal *pht* Svoboda <svobodam@eva.vsp.cz>

diff -ru iauth/mod_rfc931.c iauth/mod_rfc931.c
--- iauth/mod_rfc931.c	Thu Mar 11 20:53:20 1999
+++ iauth/mod_rfc931.c	Sun May 23 01:18:16 1999
@@ -262,7 +262,7 @@
 						    isspace(*chk))
 							break;
 					if (*chk)
-						other = 1;
+					        *chk = 0;
 					if (cldata[cl].authuser)
 						free(cldata[cl].authuser);
 					cldata[cl].authuser = mystrdup(ch);
